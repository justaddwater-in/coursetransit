{
  "apiVersion": 3,
  "name": "coursetransit/course-cards",
  "title": "CT Courses",
  "description": "Display CourseTransit courses as responsive cards.",
  "category": "course-transit",
  "icon": "welcome-learn-more",
  "textdomain": "coursetransit",
  "attributes": {
    "limit": {
      "type": "number",
      "default": 6
    },
    "columns": {
      "type": "number",
      "default": 3
    },
    "showImage": {
      "type": "boolean",
      "default": true
    },
    "showDescription": {
      "type": "boolean",
      "default": true
    },
    "showPrice": {
      "type": "boolean",
      "default": true
    },
    "buttonText": {
      "type": "string",
      "default": "View Course"
    },
    "imageSize": {
      "type": "string",
      "default": "medium_large"
    },
    "imageRatio": {
      "type": "string",
      "default": "16-9"
    },
    "orderBy": {
      "type": "string",
      "default": "added"
    },
    "order": {
      "type": "string",
      "default": "desc"
    },
    "category": {
      "type": "string",
      "default": ""
    },
    "instructor": {
      "type": "string",
      "default": ""
    },
    "search": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "editorScript": "coursetransit-course-cards-editor",
  "style": "file:./style.css",
  "editorStyle": "file:./style.css",
  "render": "file:./render.php"
}
